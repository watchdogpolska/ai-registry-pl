# Django production configuration
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=registry.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://registry.example.org

# MySQL connection used by Django.
# URL-encode special characters in the username/password if necessary.
DATABASE_URL=mysql://ai_registry:replace-me@mysql:3306/ai_registry

# Reverse proxy / HTTPS.
# Enable X-Forwarded-Proto trust only when the proxy overwrites that header.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Home page caching is disabled by default so admin edits are immediately visible.
DJANGO_HOME_PAGE_CACHE_SECONDS=0

# Public repository linked from the footer (AGPL source link). APP_VERSION and
# APP_COMMIT are baked into the image at build time, not set here.
# SOURCE_CODE_URL=https://github.com/watchdogpolska/ai-registry-pl

# Only needed by the reference compose.production.yaml MySQL service.
MYSQL_DATABASE=ai_registry
MYSQL_USER=ai_registry
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-root-password

# Host port used only by compose.production.yaml.
APP_PORT=8000
